  "description": "Schema-generation wrapper for the discriminated VLM response union.",
  "discriminator": {
    "mapping": {
      "answer": "#/$defs/AnswerResponse",
      "caption": "#/$defs/CaptionResponse",
      "point": "#/$defs/PointResponse"
