{
  "$defs": {
    "DatasetSample": {
      "additionalProperties": false,
      "description": "One licensed image mapped to the frozen vocabulary or no-target flag.",
      "properties": {
        "image_path": {
          "minLength": 1,
          "title": "Image Path",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "licence": {
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "no_target": {
          "title": "No Target",
          "type": "boolean"
        },
        "target_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Label"
        },
        "target_id": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "bbox_xyxy_normalized": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox Xyxy Normalized"
        },
        "colour_verified": {
          "default": false,
          "title": "Colour Verified",
          "type": "boolean"
        }
      },
      "required": [
        "image_path",
        "image_sha256",
        "split",
        "source",
        "source_id",
        "session_id",
        "source_url",
        "licence",
        "no_target"
      ],
      "title": "DatasetSample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Reproducible collection of scene-separated public evaluation images.",
  "properties": {
    "version": {
      "const": "v0",
      "default": "v0",
      "title": "Version",
      "type": "string"
    },
    "created_utc": {
      "format": "date-time",
      "title": "Created Utc",
      "type": "string"
    },
    "vocabulary_path": {
      "default": "configs/vocabulary_v0.yaml",
      "title": "Vocabulary Path",
      "type": "string"
    },
    "sources_path": {
      "default": "data/manifests/sources_v0.yaml",
      "title": "Sources Path",
      "type": "string"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/DatasetSample"
      },
      "title": "Samples",
      "type": "array"
    }
  },
  "required": [
    "created_utc",
    "samples"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
