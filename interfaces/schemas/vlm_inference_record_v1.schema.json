{
  "$defs": {
    "AnswerResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "vlm_response_v1",
          "default": "vlm_response_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "const": "answer",
          "title": "Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "not_visible",
            "ambiguous",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "boolean": "#/$defs/BooleanAnswer",
                  "count": "#/$defs/CountAnswer",
                  "label": "#/$defs/LabelAnswer",
                  "text": "#/$defs/TextAnswer"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/BooleanAnswer"
                },
                {
                  "$ref": "#/$defs/CountAnswer"
                },
                {
                  "$ref": "#/$defs/LabelAnswer"
                },
                {
                  "$ref": "#/$defs/TextAnswer"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        }
      },
      "required": [
        "type",
        "status"
      ],
      "title": "AnswerResponse",
      "type": "object"
    },
    "BooleanAnswer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "boolean",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanAnswer",
      "type": "object"
    },
    "CaptionResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "vlm_response_v1",
          "default": "vlm_response_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "const": "caption",
          "title": "Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "type",
        "status"
      ],
      "title": "CaptionResponse",
      "type": "object"
    },
    "CountAnswer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "count",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "CountAnswer",
      "type": "object"
    },
    "LabelAnswer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "label",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LabelAnswer",
      "type": "object"
    },
    "PointResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "vlm_response_v1",
          "default": "vlm_response_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "const": "point",
          "title": "Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "found",
            "not_visible",
            "ambiguous",
            "unknown",
            "no_candidate"
          ],
          "title": "Status",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "point": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativePoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "status"
      ],
      "title": "PointResponse",
      "type": "object"
    },
    "PreprocessingMetadata": {
      "additionalProperties": false,
      "properties": {
        "source_width_px": {
          "exclusiveMinimum": 0,
          "title": "Source Width Px",
          "type": "integer"
        },
        "source_height_px": {
          "exclusiveMinimum": 0,
          "title": "Source Height Px",
          "type": "integer"
        },
        "model_width_px": {
          "exclusiveMinimum": 0,
          "title": "Model Width Px",
          "type": "integer"
        },
        "model_height_px": {
          "exclusiveMinimum": 0,
          "title": "Model Height Px",
          "type": "integer"
        }
      },
      "required": [
        "source_width_px",
        "source_height_px",
        "model_width_px",
        "model_height_px"
      ],
      "title": "PreprocessingMetadata",
      "type": "object"
    },
    "RelativePoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1000,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "coordinate_system": {
          "const": "relative_0_1000_xy",
          "default": "relative_0_1000_xy",
          "title": "Coordinate System",
          "type": "string"
        },
        "semantics": {
          "enum": [
            "target_center",
            "review_region"
          ],
          "title": "Semantics",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "semantics"
      ],
      "title": "RelativePoint",
      "type": "object"
    },
    "SourceFrame": {
      "additionalProperties": false,
      "description": "Source identity retained in audit and supervision records only.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "sequence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Id"
        },
        "frame_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Number"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceFrame",
      "type": "object"
    },
    "TextAnswer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "TextAnswer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable audit envelope; failed parses remain visible as failures.",
  "properties": {
    "schema_version": {
      "const": "vlm_inference_record_v1",
      "default": "vlm_inference_record_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "inference_id": {
      "minLength": 1,
      "title": "Inference Id",
      "type": "string"
    },
    "image_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Image Sha256",
      "type": "string"
    },
    "source_frame": {
      "$ref": "#/$defs/SourceFrame"
    },
    "model_revision": {
      "minLength": 1,
      "title": "Model Revision",
      "type": "string"
    },
    "prompt_revision": {
      "minLength": 1,
      "title": "Prompt Revision",
      "type": "string"
    },
    "preprocessing": {
      "$ref": "#/$defs/PreprocessingMetadata"
    },
    "raw_generation": {
      "title": "Raw Generation",
      "type": "string"
    },
    "parse_errors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Parse Errors",
      "type": "array"
    },
    "response": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "answer": "#/$defs/AnswerResponse",
              "caption": "#/$defs/CaptionResponse",
              "point": "#/$defs/PointResponse"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CaptionResponse"
            },
            {
              "$ref": "#/$defs/AnswerResponse"
            },
            {
              "$ref": "#/$defs/PointResponse"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response"
    }
  },
  "required": [
    "inference_id",
    "image_sha256",
    "source_frame",
    "model_revision",
    "prompt_revision",
    "preprocessing",
    "raw_generation"
  ],
  "title": "VLMInferenceRecord",
  "type": "object"
}
