{
  "$defs": {
    "Behaviour": {
      "description": "Behaviours supported by the frozen L1 grammar.",
      "enum": [
        "FIND",
        "APPROACH",
        "HOLD"
      ],
      "title": "Behaviour",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Structured result of a successfully parsed L1 command.",
  "properties": {
    "command_id": {
      "minLength": 1,
      "title": "Command Id",
      "type": "string"
    },
    "behaviour": {
      "$ref": "#/$defs/Behaviour"
    },
    "target_label": {
      "minLength": 1,
      "title": "Target Label",
      "type": "string"
    },
    "target_id": {
      "maximum": 255,
      "minimum": 1,
      "title": "Target Id",
      "type": "integer"
    },
    "desired_distance_m": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Desired Distance M"
    },
    "command_timeout_ms": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Timeout Ms"
    }
  },
  "required": [
    "command_id",
    "behaviour",
    "target_label",
    "target_id"
  ],
  "title": "CommandState",
  "type": "object"
}
