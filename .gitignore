# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local tooling
.gstack/

# Datasets (keep documentation, manifests, and tiny intentional fixtures)
data/raw/
data/processed/
data/downloads/
data/samples/*
!data/samples/.gitkeep
!data/samples/vlm_demo/
!data/samples/vlm_demo/README.md
!data/samples/vlm_demo/source_manifest.json
/runs/
/models/

# Generated experiment artefacts (metadata and reports remain versioned)
evaluation/experiments/*/artefacts/

# Model artefacts and weights
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
configs/models/*
!configs/models/.gitkeep
!configs/models/yolo26n_coco.yaml

# Build trees
build/
dist/

# Runtime and flight logs
logs/*
!logs/README.md
*.binlog
*.tlog
